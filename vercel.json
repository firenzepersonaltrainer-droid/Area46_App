{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app-api/(.*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/app-api",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|app-api).*)",
      "destination": "/index.html"
    }
  ]
}
