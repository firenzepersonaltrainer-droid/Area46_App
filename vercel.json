{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app-api/(.*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/app-api",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|app-api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/app-api/promemoria-24h/check",
      "schedule": "0 7,9,12,15,18,21 * * *"
    }
  ]
}
